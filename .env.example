# 브라우저가 요청을 보내는 곳. 개발과 운영 모두 실제 API 주소를 지정합니다.
VITE_API_BASE_URL=https://api.example.com

# 헤더에 표시할 배포 환경 이름. 어느 서버를 보고 있는지 화면에서 구분하기 위한 값입니다.
# 비워두면 개발 중에는 LOCAL이 표시되고 운영 빌드에서는 표시되지 않습니다.
# 예: 개발, 스테이징, 운영
VITE_ENV_LABEL=

# oauth password grant의 client 값입니다.
VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_CLIENT_SECRET=

# 매체 영문 코드별 이미지 스토리지 URL. JSON 객체 문자열이며 경계에서 검증합니다.
# 코드 목록은 src/features/medias/model/media-codes.ts에 있고 모든 코드에 URL이 있어야 해당 매체의 썸네일이 표시됩니다.
# 예: {"main":"https://tvmain.example.net/","movie":"https://tvmovie.example.net/"}
VITE_MEDIA_STORAGE_URLS={}
