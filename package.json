{
  "name": "console-boilerplate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "c8 --include=src/shared/api/*.ts --include=src/shared/errors/*.ts --include=src/shared/logger/*.ts --include=src/shared/query/*.ts --include=src/features/auth/model.ts --include=src/features/entries/api/*.ts --include=src/features/entries/model/filter-entries.ts --include=src/features/entries/model/schema.ts --include=src/pages/entries/*.ts --reporter=text --reporter=html --check-coverage --lines=80 --functions=80 --branches=80 node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.556.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "react-router-dom": "^7.13.0",
    "recharts": "2.15.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.1",
    "c8": "^10.1.3",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^v7.2.7"
  }
}
